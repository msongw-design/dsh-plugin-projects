{
  "name": "dsh-plugin-projects",
  "version": "0.1.1",
  "type": "module",
  "description": "项目：邀请成员共同讨论，讨论中识别出的缺陷与体验点自动进入看板并由 Agent 复现修复",
  "license": "MIT",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msongw-design/dsh-plugin-projects.git"
  },
  "homepage": "https://github.com/msongw-design/dsh-plugin-projects#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "project",
    "kanban",
    "agent"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./protocol": "./protocol.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "protocol.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  }
}
